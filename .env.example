# Foodie AI configuration. Copy to .env and edit. Never commit .env.
APP_ENV=development
HOST=127.0.0.1
PORT=5050
DATABASE_URL=sqlite:///./data/foodie.db
LOG_LEVEL=INFO

# Secret used to hash sender identities (phone/email) before storage.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required outside development/test.
ID_HASH_PEPPER=

# Messaging: mock | bluebubbles
MESSAGE_PROVIDER=mock
BB_BASE_URL=http://127.0.0.1:1234
BB_PASSWORD=
# Shared token appended to the webhook URL you register in BlueBubbles:
#   http://127.0.0.1:5050/webhooks/bluebubbles?token=<BB_WEBHOOK_SECRET>
BB_WEBHOOK_SECRET=
BB_SEND_METHOD=apple-script

# Comma-separated chat GUIDs (e.g. iMessage;+;chat123...) and setup sender addresses.
ALLOWED_CHAT_GUIDS=
SETUP_SENDERS=

# Decisions: rules | jev
DECISION_PROVIDER=rules
JEV_ENABLED=false
JEV_API_KEY=
# Required when JEV_ENABLED=true. One of:
#   typesafe_systemone  -> POST {JEV_BASE_URL}{JEV_ENDPOINT} with model, state, questions
#                          (e.g. https://api.typesafe.ai + /v1/systemone, JEV_MODEL=jev-latest)
#   jevtypesafe_decide  -> POST {JEV_BASE_URL}{JEV_ENDPOINT} with state, questions
#                          (e.g. https://jevtypesafe.org/api + /v1/decide)
JEV_SCHEMA=
JEV_BASE_URL=
JEV_ENDPOINT=
JEV_MODEL=
JEV_TIMEOUT_SECONDS=4
JEV_MIN_CONFIDENCE=0.6
JEV_MAX_CALLS_PER_SESSION=4
JEV_MAX_CALLS_PER_DAY=200

# Places: mock (offline OSM snapshot) | osm (live Nominatim + Overpass)
PLACES_PROVIDER=mock
ENABLE_LIVE_SEARCH=false
PLACES_FIXTURE_PATH=tests/fixtures/osm_snapshot.json
GEOCODE_FIXTURE_PATH=tests/fixtures/geocode_snapshot.json
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Identify your app to OSM services as their usage policies require (add a contact URL/email you own).
OSM_USER_AGENT=FoodieAI-local-MVP/0.1
PLACES_TIMEOUT_SECONDS=45

DEFAULT_CITY=
DEFAULT_RADIUS_MILES=5
MAX_RADIUS_MILES=15
# IANA timezone used for opening-hours checks; empty = this computer's local time.
TIMEZONE=

SESSION_IDLE_MINUTES=10
COLLECT_SECONDS=15
DEBOUNCE_SECONDS=1.5
POLL_MINUTES=10
GROUP_CONSENT_MIN=2
